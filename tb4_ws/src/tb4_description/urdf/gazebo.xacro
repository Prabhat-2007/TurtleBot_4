<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Gazebo Harmonic model plugins: differential drive, joint states, IMU. -->

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>${tp}/cmd_vel</topic>
      <odom_topic>${tp}/odom</odom_topic>
      <tf_topic>${tp}/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>62</odom_publish_frequency>
      <max_linear_velocity>0.46</max_linear_velocity>
      <min_linear_velocity>-0.46</min_linear_velocity>
      <max_angular_velocity>1.9</max_angular_velocity>
      <min_angular_velocity>-1.9</min_angular_velocity>
      <max_linear_acceleration>0.9</max_linear_acceleration>
      <min_linear_acceleration>-0.9</min_linear_acceleration>
      <max_angular_acceleration>7.7</max_angular_acceleration>
      <min_angular_acceleration>-7.7</min_angular_acceleration>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>${tp}/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>${tp}/imu</topic>
      <always_on>true</always_on>
      <update_rate>62</update_rate>
    </sensor>
  </gazebo>
</robot>
