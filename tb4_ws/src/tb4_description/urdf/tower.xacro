<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- TurtleBot 4 (standard) shell, weight blocks, tower standoffs, sensor plate, camera bracket. -->

  <xacro:property name="shell_z_offset"                value="${3*cm2m}" />
  <xacro:property name="shell_mass"                    value="0.390" />

  <xacro:property name="weight_x_offset"               value="${6.005267*cm2m}"/>
  <xacro:property name="weight_y_offset"               value="${8.758841*cm2m}"/>
  <xacro:property name="bottom_weight_z_offset"        value="${9.788546*cm2m}"/>
  <xacro:property name="top_weight_z_offset"           value="${10.688546*cm2m}"/>

  <xacro:property name="front_standoff_x"              value="${3.063*cm2m}"/>
  <xacro:property name="front_standoff_y"              value="${11.431*cm2m}"/>
  <xacro:property name="rear_standoff_x"               value="${-7.607*cm2m}"/>
  <xacro:property name="rear_standoff_y"               value="${9.066*cm2m}"/>
  <xacro:property name="standoff_z"                    value="${14.757*cm2m}"/>
  <xacro:property name="sensor_plate_z"                value="${25.257*cm2m}"/>

  <joint name="shell_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="shell_link"/>
    <origin xyz="0 0 ${shell_z_offset + base_link_z_offset}" rpy="0 0 0"/>
  </joint>
  <link name="shell_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://tb4_description/meshes/shell.dae" scale="1 1 1" />
      </geometry>
    </visual>
    <collision name="shell_collision">
      <geometry>
        <mesh filename="package://tb4_description/meshes/shell_collision.dae" scale="1 1 1" />
      </geometry>
    </collision>
    <inertial>
      <mass value="${shell_mass}"/>
      <inertia ixx="0.00281295367" ixy="-0.00000137675" ixz="-0.00005790057"
               iyy="0.00164666421" iyz="0.00000564466" izz="0.00424540124" />
    </inertial>
  </link>
  <gazebo reference="shell_link"><xacro:material_black/></gazebo>
  <xacro:keep_joint name="shell_link_joint"/>

  <!-- Generic rigid part: a mesh bolted to a parent link -->
  <xacro:macro name="rigid_part" params="name parent mesh mass ixx iyy izz ixy:=0.0 ixz:=0.0 mesh_rpy:='0 0 0' *origin">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="${name}">
      <visual>
        <origin rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://tb4_description/meshes/${mesh}.dae" scale="1 1 1" />
        </geometry>
      </visual>
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="0.0" izz="${izz}" />
      </inertial>
    </link>
    <gazebo reference="${name}"><xacro:material_black/></gazebo>
    <xacro:keep_joint name="${name}_joint"/>
  </xacro:macro>

  <xacro:macro name="weight_block" params="name *origin">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="${name}">
      <visual>
        <geometry><mesh filename="package://tb4_description/meshes/weight_block.dae" scale="1 1 1" /></geometry>
      </visual>
      <inertial>
        <origin xyz="0.1 0 0"/>
        <mass value="0.061"/>
        <inertia ixx="0.0000093482" ixy="-0.00000337434" ixz="0.0"
                 iyy="0.00000436382" iyz="0.0" izz="0.00001288852" />
      </inertial>
    </link>
    <gazebo reference="${name}"><xacro:material_darkgray/></gazebo>
    <xacro:keep_joint name="${name}_joint"/>
  </xacro:macro>

  <xacro:weight_block name="front_left_bottom_weight_block">
    <origin xyz="${weight_x_offset} ${weight_y_offset} ${bottom_weight_z_offset}"/>
  </xacro:weight_block>
  <xacro:weight_block name="front_left_top_weight_block">
    <origin xyz="${weight_x_offset} ${weight_y_offset} ${top_weight_z_offset}"/>
  </xacro:weight_block>
  <xacro:weight_block name="front_right_bottom_weight_block">
    <origin xyz="${weight_x_offset} ${-weight_y_offset} ${bottom_weight_z_offset}" rpy="${pi} 0 0"/>
  </xacro:weight_block>
  <xacro:weight_block name="front_right_top_weight_block">
    <origin xyz="${weight_x_offset} ${-weight_y_offset} ${top_weight_z_offset}" rpy="${pi} 0 0"/>
  </xacro:weight_block>

  <xacro:macro name="standoff" params="name x y">
    <xacro:rigid_part name="${name}" parent="shell_link" mesh="tower_standoff" mass="0.260"
                      ixx="0.00000019604" iyy="0.00005262313" izz="0.00005262313" mesh_rpy="0 ${pi/2} 0">
      <origin xyz="${x} ${y} ${standoff_z}"/>
    </xacro:rigid_part>
  </xacro:macro>

  <xacro:standoff name="front_left_tower_standoff"  x="${front_standoff_x}" y="${front_standoff_y}"/>
  <xacro:standoff name="front_right_tower_standoff" x="${front_standoff_x}" y="${-front_standoff_y}"/>
  <xacro:standoff name="rear_left_tower_standoff"   x="${rear_standoff_x}"  y="${rear_standoff_y}"/>
  <xacro:standoff name="rear_right_tower_standoff"  x="${rear_standoff_x}"  y="${-rear_standoff_y}"/>

  <xacro:rigid_part name="tower_sensor_plate" parent="shell_link" mesh="tower_sensor_plate" mass="0.332"
                    ixx="0.00092982299" iyy="0.00083033498" izz="0.00175985947">
    <origin xyz="0 0 ${sensor_plate_z}"/>
  </xacro:rigid_part>

  <!-- Camera bracket (OAK-D mount) -->
  <xacro:rigid_part name="oakd_camera_bracket" parent="shell_link" mesh="camera_bracket" mass="0.033"
                    ixx="0.0000579181" iyy="0.0000559785" izz="0.0000140955" ixz="0.0000090679">
    <origin xyz="${-11.8*cm2m} 0 ${5.257*cm2m}"/>
  </xacro:rigid_part>
</robot>
